# ---- Service (required) ----
DATABASE_PATH=/data/agentmail.db
S2_ACCESS_TOKEN=your-s2-access-token
S2_BASIN=agentmail
DEMO_AGENT_REGISTRATION_TOKEN=replace-with-shared-secret

# ---- Service (optional) ----
# Override endpoints when using the S2 Lite in-memory emulator for local/test runs.
S2_ACCOUNT_ENDPOINT=
S2_BASIN_ENDPOINT=
PORT=8080

# ---- Demo agent (required) ----
ANTHROPIC_API_KEY=sk-ant-...
DEMO_AGENT_BASE_URL=http://localhost:8080

# ---- Demo agent (optional) ----
DEMO_AGENT_ID_FILE=/data/demo_agent_id.txt
